# Copy to .env.local (local) and set the same keys in your hosting provider (production).

# Public canonical origin — used for metadata, sitemap, robots and Open Graph URLs.
NEXT_PUBLIC_SITE_URL=https://lisbranmarketing.com

# Supabase (optional — the app falls back to local storage when unset).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google Maps JavaScript API key for /map. Restrict it by HTTP referrer in Google Cloud Console.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
